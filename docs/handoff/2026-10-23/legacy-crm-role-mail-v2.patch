@@ -0,0 +1,68 @@
+-- Bounded mail pages without collecting a role's candidate IDs in an HTTP filter.
+-- Invoker permissions and RLS remain in force; membership also fails closed explicitly.
+create or replace function public.crm_role_correspondence(
+  p_org uuid, p_role uuid, p_limit integer default 10, p_offset integer default 0
+)
+returns jsonb
+language plpgsql stable security invoker set search_path = ''
+as $$
+begin
+  if auth.uid() is null or p_org is null or not exists (
+    select 1 from public.memberships m
+    where m.user_id = auth.uid() and m.organization_id = p_org
+  ) then
+    raise exception 'CRM membership required' using errcode = '42501';
+  end if;
+  if p_role is null or not exists (
+    select 1 from public.role_specs r where r.id = p_role and r.organization_id = p_org
+  ) then
+    raise exception 'CRM role unavailable' using errcode = '42501';
+  end if;
+  if p_limit is null or p_limit < 1 or p_limit > 50
+    or p_offset is null or p_offset < 0 or p_offset > 1000000 then
+    raise exception 'Invalid correspondence page bounds' using errcode = '22023';
+  end if;
+  return (
+    with page as materialized (
+      select e.id, e.organization_id, e.candidate_id, e.lead_email, e.thread_id,
+        e.direction, e.timestamp_email, e.campaign_id, e.from_address, e.to_address,
+        e.subject, e.body_text,
+        case when jsonb_typeof(e.raw->'eaccount') = 'string' then e.raw->>'eaccount' end as eaccount
+      from public.instantly_emails e
+      join public.candidates c on c.id = e.candidate_id and c.organization_id = e.organization_id
+      where e.organization_id = p_org
+        and (
+          exists (select 1 from public.candidate_role_memberships m
+            where m.organization_id = p_org and m.role_spec_id = p_role and m.candidate_id = c.id)
+          or exists (select 1 from public.candidate_pipeline p
+            where p.organization_id = p_org and p.role_spec_id = p_role and p.candidate_id = c.id)
+          or exists (
+            select 1 from public.instantly_leads l
+            join public.instantly_campaigns campaign on campaign.id = l.campaign_id
+              and campaign.organization_id = l.organization_id
+            where l.organization_id = p_org and l.candidate_id = c.id and campaign.role_spec_id = p_role
+          )
+        )
+        -- Candidate membership does not authorize another role's explicitly bound mail.
+        -- Null/unbound campaign metadata retains the existing candidate-linked semantics.
+        and (e.campaign_id is null or exists (
+          select 1 from public.instantly_campaigns campaign where campaign.id = e.campaign_id
+            and campaign.organization_id = p_org
+            and (campaign.role_spec_id is null or campaign.role_spec_id = p_role)
+        ))
+      order by e.timestamp_email desc nulls last, e.id desc
+      limit p_limit + 1 offset p_offset
+    ), selected as (
+      select * from page order by timestamp_email desc nulls last, id desc limit p_limit
+    )
+    select jsonb_build_object(
+      'organization_id', p_org, 'role_id', p_role, 'pagination', 'offset',
+      'messages', coalesce((select jsonb_agg(to_jsonb(s) order by s.timestamp_email desc nulls last, s.id desc)
+        from selected s), '[]'::jsonb),
+      'next_offset', case when (select count(*) from page) > p_limit then p_offset + p_limit else null end
+    )
+  );
+end;
+$$;
+revoke all on function public.crm_role_correspondence(uuid, uuid, integer, integer) from public, anon;
+grant execute on function public.crm_role_correspondence(uuid, uuid, integer, integer) to authenticated;
