+-- Preserve secondary formal and campaign role associations from the current CRM listing.
+create or replace function public.crm_candidate_presence(
+  p_org uuid, p_candidate_ids uuid[], p_role uuid default null
+)
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+declare
+  wanted_client text;
+  wanted_role text;
+begin
+  if auth.uid() is null or p_org is null or not exists (
+    select 1 from public.memberships m
+    where m.user_id = auth.uid() and m.organization_id = p_org
+  ) then
+    raise exception 'CRM membership required' using errcode = '42501';
+  end if;
+  if p_candidate_ids is null or cardinality(p_candidate_ids) > 50
+    or array_position(p_candidate_ids, null) is not null then
+    raise exception 'Expected at most 50 candidate IDs' using errcode = '22023';
+  end if;
+  if p_role is not null then
+    select btrim(c.name), btrim(r.title) into wanted_client, wanted_role
+    from public.role_specs r
+    join public.clients c on c.id = r.client_id and c.organization_id = p_org
+    where r.id = p_role and r.organization_id = p_org and r.archived_at is null;
+    if not found or coalesce(wanted_client, '') = '' or coalesce(wanted_role, '') = '' then
+      raise exception 'CRM role unavailable' using errcode = '42501';
+    end if;
+  end if;
+  return (
+    with campaign_roles as materialized (
+      select distinct il.candidate_id,
+        coalesce(nullif(btrim(cl.name), ''), 'Unassigned') as client_label,
+        coalesce(nullif(btrim(rs.title), ''), nullif(btrim(ic.name), ''), 'Campaign') as role_label
+      from public.instantly_leads il
+      join public.instantly_campaigns ic on ic.id = il.campaign_id and ic.organization_id = il.organization_id
+      left join public.role_specs rs on rs.id = ic.role_spec_id and rs.organization_id = ic.organization_id
+      left join public.clients cl on cl.id = coalesce(rs.client_id, ic.client_id) and cl.organization_id = ic.organization_id
+      where il.organization_id = p_org and il.candidate_id = any(p_candidate_ids) and rs.archived_at is null
+      union
+      select m.candidate_id, coalesce(nullif(btrim(cl.name), ''), 'Unassigned'),
+        coalesce(nullif(btrim(rs.title), ''), 'No role')
+      from public.candidate_role_memberships m
+      join public.role_specs rs on rs.id = m.role_spec_id and rs.organization_id = m.organization_id
+      join public.clients cl on cl.id = rs.client_id and cl.organization_id = m.organization_id
+      where m.organization_id = p_org and m.candidate_id = any(p_candidate_ids) and rs.archived_at is null
+    ), primary_campaign as materialized (
+      select distinct on (candidate_id) candidate_id, client_label, role_label
+      from campaign_roles
+      order by candidate_id, (client_label <> 'Unassigned') desc, client_label, role_label
+    ), present as materialized (
+      select c.id,
+        coalesce(nullif(btrim(cl.name), ''), nullif(nullif(btrim(sg.src_client), ''), 'Unassigned'), pc.client_label, 'Unassigned') as client_label,
+        coalesce(nullif(btrim(rs.title), ''), nullif(nullif(btrim(p.tracker_role), ''), 'No role'),
+          nullif(nullif(btrim(sg.src_role), ''), 'No role'), pc.role_label, 'No role') as role_label
+      from public.candidates c
+      left join public.candidate_pipeline p on p.candidate_id = c.id and p.organization_id = c.organization_id
+      left join public.role_specs rs on rs.id = p.role_spec_id and rs.organization_id = c.organization_id
+      left join public.clients cl on cl.id = rs.client_id and cl.organization_id = c.organization_id
+      left join public.crm_candidate_signals sg on sg.candidate_id = c.id and sg.organization_id = c.organization_id
+      left join primary_campaign pc on pc.candidate_id = c.id
+      where c.organization_id = p_org and c.id = any(p_candidate_ids)
+    )
+    select jsonb_build_object(
+      'candidate_ids', coalesce((select jsonb_agg(distinct id) from present), '[]'::jsonb),
+      'role_candidate_ids', case when p_role is null then null else
+        coalesce((select jsonb_agg(distinct id) from present
+          where (client_label = wanted_client and role_label = wanted_role)
+          or exists (select 1 from campaign_roles cr where cr.candidate_id = present.id
+            and cr.client_label = wanted_client and cr.role_label = wanted_role)), '[]'::jsonb) end
+    )
+  );
+end;
+$$;
+revoke all on function public.crm_candidate_presence(uuid, uuid[], uuid) from public, anon;
+grant execute on function public.crm_candidate_presence(uuid, uuid[], uuid) to authenticated;
