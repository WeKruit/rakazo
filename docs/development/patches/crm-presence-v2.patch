+insert into candidate_pipeline values ('00000000-0000-4000-8000-000000000041','00000000-0000-4000-8000-000000000030',null,'00000000-0000-4000-8000-000000000010');
 insert into crm_candidate_signals values
- ('00000000-0000-4000-8000-000000000042','Example','Engineer'),
- ('00000000-0000-4000-8000-000000000043','Example','Designer');
+ ('00000000-0000-4000-8000-000000000042','Example','Engineer','00000000-0000-4000-8000-000000000010'),
+ ('00000000-0000-4000-8000-000000000043','Example','Designer','00000000-0000-4000-8000-000000000010');
 do $$
 declare
  ids uuid[] := array['00000000-0000-4000-8000-000000000041','00000000-0000-4000-8000-000000000042','00000000-0000-4000-8000-000000000043','00000000-0000-4000-8000-000000000044','00000000-0000-4000-8000-000000000045']::uuid[];
@@ -51,6 +55,24 @@ begin
    perform public.crm_candidate_presence('00000000-0000-4000-8000-000000000010',array_fill(ids[1],array[51]));
    raise exception 'Unbounded IDs accepted';
  exception when invalid_parameter_value then null; end;
+ -- SECURITY DEFINER joins must not use foreign-org rows with matching candidate IDs.
+ insert into candidate_pipeline values ('00000000-0000-4000-8000-000000000043','00000000-0000-4000-8000-000000000030',null,'00000000-0000-4000-8000-000000000099');
+ insert into crm_candidate_signals values ('00000000-0000-4000-8000-000000000043','Example','Engineer','00000000-0000-4000-8000-000000000099');
+ result := public.crm_candidate_presence('00000000-0000-4000-8000-000000000010',ids,'00000000-0000-4000-8000-000000000030');
+ if result->'role_candidate_ids' ? '00000000-0000-4000-8000-000000000043' then
+   raise exception 'Foreign organization affected role presence';
+ end if;
+ -- A second formal role must survive even when canonical/source labels differ.
+ insert into role_specs values ('00000000-0000-4000-8000-000000000031','00000000-0000-4000-8000-000000000010','00000000-0000-4000-8000-000000000020','Second',null);
+ insert into candidate_role_memberships values ('00000000-0000-4000-8000-000000000041','00000000-0000-4000-8000-000000000031','00000000-0000-4000-8000-000000000010');
+ insert into instantly_campaigns values ('campaign','00000000-0000-4000-8000-000000000010','Second','00000000-0000-4000-8000-000000000031','00000000-0000-4000-8000-000000000020');
+ insert into instantly_leads values ('00000000-0000-4000-8000-000000000043','campaign','00000000-0000-4000-8000-000000000010');
+ result := public.crm_candidate_presence('00000000-0000-4000-8000-000000000010',ids,'00000000-0000-4000-8000-000000000031');
+ if jsonb_array_length(result->'role_candidate_ids') <> 2
+   or not (result->'role_candidate_ids' ? '00000000-0000-4000-8000-000000000041')
+   or not (result->'role_candidate_ids' ? '00000000-0000-4000-8000-000000000043') then
+   raise exception 'Secondary formal/campaign role association lost: %',result;
+ end if;
  update role_specs set archived_at=now();
  begin
    perform public.crm_candidate_presence('00000000-0000-4000-8000-000000000010',ids,'00000000-0000-4000-8000-000000000030');
